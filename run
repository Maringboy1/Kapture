#!/usr/bin/env python3
import os
import sys
import subprocess

HERE = os.path.dirname(os.path.abspath(__file__))
if HERE not in sys.path:
    sys.path.insert(0, HERE)


def ensure_dependencies():
    missing = []
    try:
        import PyQt6
    except ImportError:
        missing.append("PyQt6>=6.4.0")
    try:
        import PIL
    except ImportError:
        missing.append("Pillow>=9.0.0")

    if missing:
        print(f"[*] Missing required Python dependencies: {', '.join(missing)}")
        print("[*] Automatically downloading and installing requirements...")
        req_file = os.path.join(HERE, "requirements.txt")
        cmd = [sys.executable, "-m", "pip", "install", "-r", req_file]
        try:
            subprocess.check_call(cmd)
            print("[+] Successfully installed dependencies.")
        except Exception:
            try:
                subprocess.check_call(cmd + ["--break-system-packages"])
                print("[+] Successfully installed dependencies.")
            except Exception as e:
                print(f"[!] Could not auto-install via pip: {e}")
                print("[!] Please run './install.sh' or 'sudo apt install python3-pyqt6 python3-pil'")
                sys.exit(1)


ensure_dependencies()

from kapture.__main__ import main
sys.exit(main())
